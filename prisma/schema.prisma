// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  CLIENT
  PM
  ADMIN
}

enum PaymentType {
  RETAINER
  SUCCESS
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentProvider {
  PAYSTACK
  MANUAL
  OTHER
}

enum ArticleCategory {
  PRICE_DATA
  LEGAL_GUIDES
  AREA_ANALYSIS
  FRAUD_WARNINGS
  HOW_TO_GUIDES
}

enum IntakeStatus {
  DRAFT
  PENDING
  REVIEWING
  ACTIVE
  CLOSED
}

enum ServiceType {
  REAL_ESTATE
  RENEWABLE_ENERGY
  INTEGRATED
}

enum ProjectStageStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityType {
  PROJECT_CREATED
  PM_ASSIGNED
  STAGE_STARTED
  STAGE_COMPLETED
  TASK_CREATED
  TASK_SUBMITTED
  TASK_APPROVED
  TASK_REJECTED
  DOCUMENT_UPLOADED
  MESSAGE_SENT
  MANUAL_UPDATE
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  /// Maps to auth.users.id in Supabase — UUID stored as String
  id        String    @id @db.Uuid
  email     String    @unique
  role      Role      @default(CLIENT)
  createdAt DateTime  @default(now()) @map("created_at")
  lastLogin DateTime? @map("last_login")

  // Profile — shared across all roles
  fullName      String? @map("full_name")
  preferredName String? @map("preferred_name")
  phone         String?
  photoUrl      String? @map("photo_url")

  // Client-only fields (nullable; only populated when role = CLIENT)
  nationality        String?
  location           String?
  idType             String? @map("id_type")
  idNumber           String? @map("id_number")
  onboardingComplete Boolean @default(false) @map("onboarding_complete")

  // PM assigned to this client (null for PM/ADMIN users)
  assignedPmId   String? @map("assigned_pm_id") @db.Uuid
  assignedPm     User?   @relation("ClientPm", fields: [assignedPmId], references: [id], onDelete: SetNull)
  managedClients User[]  @relation("ClientPm")

  // Client's PM-change request flags
  pmChangeRequested Boolean @default(false) @map("pm_change_requested")
  pmChangeReason    String? @map("pm_change_reason")

  // Relations
  enquiries           Enquiry[]
  engagements         Engagement[]
  managedEngagements  Engagement[]       @relation("EngagementPm")
  notifications       Notification[]
  sentMessages        Message[]          @relation("SentMessages")
  auditLogs           AuditLog[]
  updates             Update[]
  articles            Article[]
  intakeSubmissions   IntakeSubmission[]
  meetingsAsPm        StrategyMeeting[]  @relation("MeetingPm")
  signedAgreements    ServiceAgreement[] @relation("AgreementSigner")
  createdTasks        Task[]             @relation("TaskCreator")
  assignedTasks       Task[]             @relation("TaskAssignee")
  reviewedSubmissions TaskSubmission[]   @relation("SubmissionReviewer")
  activityLogs        ActivityLog[]      @relation("ActivityActor")

  @@map("users")
}

model Enquiry {
  id              String   @id @default(cuid())
  userId          String   @map("user_id") @db.Uuid
  source          String?
  transactionType String?  @map("transaction_type")
  brief           String?
  status          String   @default("open")
  assignedAdvisor String?  @map("assigned_advisor")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("enquiries")
}

model Engagement {
  id     String  @id @default(cuid())
  userId String  @map("user_id") @db.Uuid
  pmId   String? @map("pm_id") @db.Uuid

  // Service configuration
  serviceId          String? @map("service_id")
  workflowTemplateId String? @map("workflow_template_id")
  intakeSubmissionId String? @unique @map("intake_submission_id")

  // Deprecated fields (keep for old data)
  serviceTier   String? @map("service_tier")
  serviceTierId String? @map("service_tier_id")
  stage         String  @default("discovery")

  startDate  DateTime? @map("start_date")
  targetDate DateTime? @map("target_date")
  status     String    @default("active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  pm               User?             @relation("EngagementPm", fields: [pmId], references: [id], onDelete: SetNull)
  service          Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  workflowTemplate WorkflowTemplate? @relation(fields: [workflowTemplateId], references: [id], onDelete: SetNull)
  intakeSubmission IntakeSubmission? @relation(fields: [intakeSubmissionId], references: [id], onDelete: SetNull)

  documents        Document[]
  updates          Update[]
  messages         Message[]
  payments         Payment[]
  invoices         Invoice[]
  agreement        ServiceAgreement?
  strategyMeetings StrategyMeeting[]
  projectStages    ProjectStage[]
  tasks            Task[]
  activityLogs     ActivityLog[]

  @@map("engagements")
}

model Document {
  id              String   @id @default(cuid())
  engagementId    String   @map("engagement_id")
  name            String
  title           String?
  category        String?
  filePath        String   @map("file_path")
  uploadedBy      String   @map("uploaded_by") @db.Uuid
  uploadedAt      DateTime @default(now()) @map("uploaded_at")
  version         Int      @default(1)
  isClientVisible Boolean  @default(true) @map("is_client_visible")

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model Update {
  id           String    @id @default(cuid())
  engagementId String    @map("engagement_id")
  pmId         String    @map("pm_id") @db.Uuid
  content      String
  nextSteps    String?   @map("next_steps")
  publishedAt  DateTime? @map("published_at")
  draft        Boolean   @default(true)

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  pm         User       @relation(fields: [pmId], references: [id])

  @@map("updates")
}

model Message {
  id             String    @id @default(cuid())
  engagementId   String    @map("engagement_id")
  senderId       String    @map("sender_id") @db.Uuid
  body           String
  attachmentPath String?   @map("attachment_path")
  sentAt         DateTime  @default(now()) @map("sent_at")
  readAt         DateTime? @map("read_at")

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  sender     User       @relation("SentMessages", fields: [senderId], references: [id])

  @@map("messages")
}

model Payment {
  id           String          @id @default(cuid())
  engagementId String          @map("engagement_id")
  type         PaymentType     @default(OTHER)
  amount       Float
  currency     String          @default("NGN")
  provider     PaymentProvider @default(PAYSTACK)
  status       PaymentStatus   @default(PENDING)
  reference    String?         @unique
  paidAt       DateTime?       @map("paid_at")
  createdAt    DateTime        @default(now()) @map("created_at")

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") @db.Uuid
  type      String
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Article {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  excerpt     String
  authorId    String          @map("author_id") @db.Uuid
  author      User            @relation(fields: [authorId], references: [id])
  publishedAt DateTime        @map("published_at")
  readTime    Int             @map("read_time")
  category    ArticleCategory
  image       String
  featured    Boolean         @default(false)
  body        String?
  published   Boolean         @default(true)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@map("articles")
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String   @map("user_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json?
  ipAddress    String?  @map("ip_address")
  timestamp    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resourceType, resourceId])
  @@index([timestamp])
  @@map("audit_log")
}

model IntakeSubmission {
  id              String       @id @default(cuid())
  referenceNumber String       @unique @map("reference_number")
  status          IntakeStatus @default(PENDING)

  // Optional link to a user account (created on submit)
  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Service Selection (NEW)
  selectedServices       String[] @default([]) @map("selected_services")
  energyNeedsDescription String?  @map("energy_needs_description")
  combinedServices       Boolean  @default(false) @map("combined_services")

  // Step 1 — Goal (conditional: only if Real Estate selected)
  transactionType String? @map("transaction_type")
  purpose         String?

  // Step 2 — About you
  fullName      String  @map("full_name")
  preferredName String? @map("preferred_name")
  email         String
  phone         String
  location      String
  nationality   String?

  // Step 3 — Property (conditional: only if Real Estate selected)
  targetAreas  String[] @default([]) @map("target_areas")
  propertyType String?  @map("property_type")
  bedrooms     String?
  floorAreaSqm String?  @map("floor_area_sqm")
  mustHaves    String[] @default([]) @map("must_haves")
  dealBreakers String?  @map("deal_breakers")

  // Step 4 — Budget
  currency       String  @default("NGN")
  budgetMin      String? @map("budget_min")
  budgetMax      String? @map("budget_max")
  sourceOfFunds  String? @map("source_of_funds")
  mortgageStatus String? @map("mortgage_status")

  // Step 5 — Timeline & background
  targetDate      String? @map("target_date")
  decisionSpeed   String? @map("decision_speed")
  decisionMakers  String? @map("decision_makers")
  priorExperience String? @map("prior_experience")
  riskProfile     String? @map("risk_profile")
  referralSource  String? @map("referral_source")

  // Consent
  dataConsent Boolean @default(false) @map("data_consent")

  // Draft save-and-continue
  draftStep Int? @map("draft_step")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  engagement Engagement?

  @@map("intake_submissions")
}

model StrategyMeeting {
  id           String    @id @default(cuid())
  engagementId String    @map("engagement_id")
  pmId         String    @map("pm_id") @db.Uuid
  title        String?
  scheduledAt  DateTime  @map("scheduled_at")
  meetingLink  String?   @map("meeting_link")
  notes        String?
  status       String    @default("SCHEDULED")
  sentAt       DateTime? @map("sent_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  pm         User       @relation("MeetingPm", fields: [pmId], references: [id])

  @@map("strategy_meetings")
}

model ServiceAgreement {
  id           String @id @default(cuid())
  engagementId String @unique @map("engagement_id")

  // Service reference (NEW)
  serviceId String?  @map("service_id")
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  // Deprecated field (keep for old data)
  serviceTier String? @map("service_tier")

  scopeDescription  String    @map("scope_description")
  timeline          String?
  deliverables      String[]
  feeAmount         Float     @map("fee_amount")
  currency          String    @default("NGN")
  terms             String
  version           Int       @default(1)
  status            String    @default("PENDING")
  signedAt          DateTime? @map("signed_at")
  signerName        String?   @map("signer_name")
  signatureImageUrl String?   @map("signature_image_url")
  signedByUserId    String?   @map("signed_by_user_id") @db.Uuid
  generatedAt       DateTime  @default(now()) @map("generated_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  signedByUser User?      @relation("AgreementSigner", fields: [signedByUserId], references: [id], onDelete: SetNull)
  invoices     Invoice[]

  @@map("service_agreements")
}

model Invoice {
  id                 String    @id @default(cuid())
  engagementId       String    @map("engagement_id")
  invoiceNumber      String    @unique @map("invoice_number")
  description        String
  amount             Float
  currency           String    @default("NGN")
  status             String    @default("DRAFT")
  dueDate            DateTime? @map("due_date")
  issuedAt           DateTime? @map("issued_at")
  paidAt             DateTime? @map("paid_at")
  paystackReference  String?   @unique @map("paystack_reference")
  serviceAgreementId String?   @map("service_agreement_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  engagement       Engagement        @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  serviceAgreement ServiceAgreement? @relation(fields: [serviceAgreementId], references: [id], onDelete: SetNull)

  @@map("invoices")
}

// ─── Project Management Models ───────────────────────────────────────────────

model Service {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  type        ServiceType
  description String?
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  workflowTemplates WorkflowTemplate[]
  engagements       Engagement[]
  serviceAgreements ServiceAgreement[]

  @@map("services")
}

model WorkflowTemplate {
  id          String   @id @default(cuid())
  serviceId   String   @map("service_id")
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  service     Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  stages      WorkflowStage[]
  engagements Engagement[]

  @@unique([serviceId, name])
  @@map("workflow_templates")
}

model WorkflowStage {
  id                 String   @id @default(cuid())
  workflowTemplateId String   @map("workflow_template_id")
  name               String
  description        String?
  order              Int
  estimatedDays      Int?     @map("estimated_days")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  workflowTemplate WorkflowTemplate @relation(fields: [workflowTemplateId], references: [id], onDelete: Cascade)
  projectStages    ProjectStage[]

  @@unique([workflowTemplateId, order])
  @@map("workflow_stages")
}

model ProjectStage {
  id              String             @id @default(cuid())
  engagementId    String             @map("engagement_id")
  workflowStageId String             @map("workflow_stage_id")
  order           Int
  status          ProjectStageStatus @default(NOT_STARTED)
  startedAt       DateTime?          @map("started_at")
  completedAt     DateTime?          @map("completed_at")
  notes           String?
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  engagement    Engagement    @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  workflowStage WorkflowStage @relation(fields: [workflowStageId], references: [id], onDelete: Restrict)

  @@index([engagementId])
  @@map("project_stages")
}

model Task {
  id           String       @id @default(cuid())
  engagementId String       @map("engagement_id")
  assignedTo   String       @map("assigned_to") @db.Uuid
  createdBy    String       @map("created_by") @db.Uuid
  title        String
  description  String?
  dueDate      DateTime?    @map("due_date")
  priority     TaskPriority @default(MEDIUM)
  status       TaskStatus   @default(PENDING)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  engagement  Engagement      @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  assignee    User            @relation("TaskAssignee", fields: [assignedTo], references: [id], onDelete: Cascade)
  creator     User            @relation("TaskCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  submission  TaskSubmission?

  @@index([assignedTo])
  @@index([engagementId])
  @@map("tasks")
}

model TaskSubmission {
  id              String    @id @default(cuid())
  taskId          String    @map("task_id")
  responseText    String?   @map("response_text")
  attachmentPaths String[]  @default([]) @map("attachment_paths")
  submittedAt     DateTime  @default(now()) @map("submitted_at")
  reviewedAt      DateTime? @map("reviewed_at")
  reviewedBy      String?   @map("reviewed_by") @db.Uuid
  approvalStatus  String?   @map("approval_status")
  feedback        String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  task     Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reviewer User? @relation("SubmissionReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@unique([taskId])
  @@map("task_submissions")
}

model ActivityLog {
  id           String       @id @default(cuid())
  engagementId String       @map("engagement_id")
  actorId      String       @map("actor_id") @db.Uuid
  actorRole    Role
  actionType   ActivityType @map("action_type")
  description  String
  metadata     Json?
  timestamp    DateTime     @default(now())

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  actor      User       @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([engagementId])
  @@index([timestamp])
  @@map("activity_logs")
}
